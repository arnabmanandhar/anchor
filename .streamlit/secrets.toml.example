# Copy to .streamlit/secrets.toml for local runs, or paste the same lines into
# Streamlit Community Cloud -> your app -> Settings -> Secrets.
# NEVER commit the real secrets.toml (it is in .gitignore).

# Give every visitor a private workspace (recommended for public deploys).
ANCHOR_PUBLIC = "1"

# ---- Optional: a built-in model for visitors without their own key ----
# Visitors can always add their own key (any provider) in the sidebar. If
# you also set ONE key below, visitors without a key get a limited number
# of calls on it. Your key is never shown, logged or sent to the browser.
# A free-tier key (Gemini, Groq, OpenRouter) keeps the demo at zero cost.
# GEMINI_API_KEY = "AIza...your-key"
# GROQ_API_KEY = "gsk_...your-key"
# OPENROUTER_API_KEY = "sk-or-...your-key"

# Which provider/model the built-in key uses (default: the first key found,
# with that provider's suggested model).
# ANCHOR_SERVER_PROVIDER = "gemini"
# ANCHOR_SERVER_MODEL = "gemini-3.8-flash"

# Limits on the built-in key.
# ANCHOR_SERVER_KEY_SESSION_LIMIT = "25"   # calls per browser session
# ANCHOR_SERVER_KEY_DAILY_LIMIT = "500"    # calls per day, all visitors together

# Visitors' own keys are forgotten after this many idle minutes.
# ANCHOR_KEY_TTL_MINUTES = "60"
