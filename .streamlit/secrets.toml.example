# Copy to .streamlit/secrets.toml for local runs, or paste the same lines into
# Streamlit Community Cloud -> your app -> Settings -> Secrets.
#
# NEVER commit the real secrets.toml (it is in .gitignore).
#
# Optional. If set, visitors who don't paste their own key get a few LLM
# judge calls per session on this key (ANCHOR_SERVER_KEY_SESSION_LIMIT,
# default 5). Leave it out to keep the public demo at zero cost: visitors
# can still paste their own key, and everyone else gets the offline judge.
# Give every visitor a private workspace (recommended for public deploys).
ANCHOR_PUBLIC = "1"

ANTHROPIC_API_KEY = "sk-ant-your-key-here"
